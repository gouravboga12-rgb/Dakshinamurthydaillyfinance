{
  "expo": {
    "name": "Dakshinamurthy Daily Ledger",
    "slug": "daily-finance-customer",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dakshinamurthy.dailyledger"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [],
      "package": "com.dakshinamurthy.dailyledger",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "port": 8082,
      "name": "Dakshinamurthy Daily Finance",
      "shortName": "Daily Finance",
      "themeColor": "#0F172A",
      "backgroundColor": "#0F172A",
      "display": "standalone"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ]
    ],
    "owner": "daily_finance",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "10f07f13-8c5a-47cc-86f7-31c16b02583f"
      }
    }
  }
}
